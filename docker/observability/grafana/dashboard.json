{
  "title": "HvostID service health", "uid": "hvostid", "schemaVersion": 41,
  "refresh": "15s", "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id":1,"type":"stat","title":"Service availability","gridPos":{"x":0,"y":0,"w":24,"h":5},"datasource":{"uid":"prometheus"},"targets":[{"expr":"up{job=\"hvostid\"}","legendFormat":"{{service}}"}]},
    {"id":2,"type":"timeseries","title":"Requests per second","gridPos":{"x":0,"y":5,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by(service) (rate(http_server_requests_seconds_count[5m]))","legendFormat":"{{service}}"}]},
    {"id":3,"type":"timeseries","title":"HTTP 5xx per second","gridPos":{"x":12,"y":5,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"sum by(service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))","legendFormat":"{{service}}"}]},
    {"id":4,"type":"timeseries","title":"HTTP p95 seconds","gridPos":{"x":0,"y":13,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le,service) (rate(http_server_requests_seconds_bucket[5m])))","legendFormat":"{{service}}"}]},
    {"id":5,"type":"timeseries","title":"Database connections waiting","gridPos":{"x":12,"y":13,"w":12,"h":8},"datasource":{"uid":"prometheus"},"targets":[{"expr":"hikaricp_connections_pending","legendFormat":"{{service}}"}]}
  ]
}

{
    "name": "hvostid-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,css,html}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css,html}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "axios": "^1.16.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-error-boundary": "^6.1.6",
        "react-router-dom": "^7.15.1"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.8.4",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "autoprefixer": "^10.5.0",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "jsdom": "^30.1.1",
        "lint-staged": "^17.0.5",
        "postcss": "^8.5.15",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.14",
        "vitest": "^5.0.2"
    },
    "lint-staged": {
        "**/*.{js,jsx}": [
            "eslint --fix --no-warn-ignored",
            "prettier --write"
        ],
        "**/*.{css,html,json}": [
            "prettier --write"
        ]
    }
}

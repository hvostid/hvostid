{
    "name": "hvostid-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,css,html}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,css,html}\""
    },
    "dependencies": {
        "axios": "^1.20.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.19.0",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "autoprefixer": "^10.5.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "lint-staged": "^17.5.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.2"
    },
    "lint-staged": {
        "**/*.{js,jsx}": [
            "eslint --fix --no-warn-ignored",
            "prettier --write"
        ],
        "**/*.{css,html,json}": [
            "prettier --write"
        ]
    }
}

# PostgreSQL
DB_USER=hvostid
DB_PASSWORD=hvostid

# Demo seed (T42): set to "demo" to load Flyway seed data on backend startup.
# Used by ./scripts/seed-all.sh. Leave empty for production-like runs (CI/CD).
# SPRING_PROFILES_ACTIVE=demo

# MinIO (S3-compatible storage)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_DOCUMENTS_BUCKET=pet-documents
MINIO_PHOTOS_BUCKET=pet-photos

# SonarQube (optional, for CI)
# SONAR_TOKEN=
# SONAR_HOST_URL=http://localhost:9090

# Separate application database roles (administrative DB_USER is not used by services).
AUTH_DB_PASSWORD=hvostid_auth
LISTING_DB_PASSWORD=hvostid_listing
PASSPORT_DB_PASSWORD=hvostid_passport
MATCHING_DB_PASSWORD=hvostid_matching

# The gateway trusts only this frontend proxy address, never arbitrary X-Forwarded-For.
HVOSTID_SUBNET=172.30.44.0/24
# Dynamic addresses cannot overlap the trusted frontend (.10) or TLS edge (.11).
HVOSTID_DYNAMIC_RANGE=172.30.44.128/25
HVOSTID_FRONTEND_IP=172.30.44.10
MATCHING_PARALLELISM=16
MATCHING_MAX_COMPUTATIONS=8

# Enable mail after configuring your SMTP provider; values are local development defaults.
AUTH_MAIL_ENABLED=false
AUTH_MAIL_FROM=no-reply@localhost
AUTH_PUBLIC_BASE_URL=http://localhost:3000
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Base64-encoded 32-byte key for the durable email outbox; required when mail is enabled.
AUTH_MAIL_ENCRYPTION_KEY=

MATCHING_MAX_SCANNED_LISTINGS=10000
MATCHING_COMPUTATION_TIMEOUT=30s

# Image tag (matches GHCR tag pushed by T26)
IMAGE_TAG=latest

# GHCR owner (used by image: in docker-compose.prod.yml)
GHCR_OWNER=hvostid

# PostgreSQL credentials (do not use defaults)
DB_USER=hvostid
DB_PASSWORD=CHANGE_ME

# MinIO credentials (do not use defaults)
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_DOCUMENTS_BUCKET=pet-documents
MINIO_PHOTOS_BUCKET=pet-photos

# Public origins allowed for CORS on api-gateway
HVOSTID_CORS_ALLOWED_ORIGINS=http://localhost

# Distinct passwords for least-privilege application roles.
AUTH_DB_PASSWORD=CHANGE_ME_AUTH
LISTING_DB_PASSWORD=CHANGE_ME_LISTING
PASSPORT_DB_PASSWORD=CHANGE_ME_PASSPORT
MATCHING_DB_PASSWORD=CHANGE_ME_MATCHING
HVOSTID_SUBNET=172.30.44.0/24
HVOSTID_FRONTEND_IP=172.30.44.10
MATCHING_PARALLELISM=16
MATCHING_MAX_COMPUTATIONS=8
AUTH_MAIL_ENABLED=false
AUTH_MAIL_FROM=no-reply@example.com
AUTH_PUBLIC_BASE_URL=https://example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# Optional docker-compose.tls.yml: public hostname with DNS pointing at the host.
PUBLIC_HOST=example.com

# Base64-encoded 32-byte key for the durable email outbox; required when mail is enabled.
AUTH_MAIL_ENCRYPTION_KEY=

MATCHING_MAX_SCANNED_LISTINGS=10000
MATCHING_COMPUTATION_TIMEOUT=30s
